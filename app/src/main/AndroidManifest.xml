<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AquaSaver"
        tools:targetApi="31">

        <!-- LoginActivity is the launcher screen -->
        <activity
            android:name="com.aquasaver.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.AquaSaver.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SignupActivity -->
        <activity
            android:name="com.aquasaver.SignupActivity"
            android:exported="true"
            android:theme="@style/Theme.AquaSaver.NoActionBar" />

        <!-- MainActivity (used after login/signup) -->
        <activity
            android:name="com.example.aquasaver.ui.activities.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AquaSaver.NoActionBar" />

        <!-- ClimateAlertsActivity (used after login/signup) -->
        <activity
            android:name="com.example.aquasaver.ui.activities.ClimateAlertsActivity"
            android:exported="true"
            android:theme="@style/Theme.AquaSaver.NoActionBar" />


        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>
</manifest>