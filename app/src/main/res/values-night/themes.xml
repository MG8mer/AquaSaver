<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.HomePageWaterUsage1" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="android:textSize">14sp</item>
        <item name="colorSecondaryContainer">#6495ED</item> <!-- Darker blue for buttons -->
        <item name="colorOnSecondaryContainer">@android:color/white</item> <!-- Text on buttons -->
        <item name="colorButtonNormal">#6495ED</item> <!-- Button default color -->
        <item name="rippleColor">#806495ED</item> <!-- Ripple effect -->
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/nightColorPrimary</item>
        <item name="colorPrimaryVariant">@color/nightColorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/nightColorOnPrimary</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/nightColorSecondary</item>
        <item name="colorSecondaryVariant">@color/nightColorSecondaryVariant</item>
        <item name="colorOnSecondary">@color/nightColorOnSecondary</item>

        <!-- Tertiary (optional for Material 2) -->
        <item name="colorTertiary">@color/nightColorTertiary</item>
        <item name="colorOnTertiary">@color/nightColorOnTertiary</item>

        <!-- Background and surface -->
        <item name="colorOnBackground">@color/nightColorOnBackground</item>
        <item name="colorSurface">@color/nightColorSurface</item>
        <item name="colorOnSurface">@color/nightColorOnSurface</item>
        <item name="colorSurfaceVariant">@color/nightColorSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/nightColorOnSurfaceVariant</item>

        <!-- Outline and error -->
        <item name="colorOutline">@color/nightColorOutline</item>
        <item name="colorError">@color/nightColorError</item>
        <item name="colorOnError">@color/nightColorOnError</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@android:color/holo_red_dark</item>
        <!-- Customize your theme here. -->
    </style>
</resources>