<resources>
    <!-- Existing base theme -->
    <style name="Theme.AquaSaver" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Customize your theme here -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
    </style>

    <!-- NoActionBar variant -->
    <style name="Theme.AquaSaver.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Add overrides if needed -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
    </style>
    <style name="Theme.AquaSaver.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.AquaSaver.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
