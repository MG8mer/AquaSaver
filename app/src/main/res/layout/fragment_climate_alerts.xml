<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F9FAFB"
    tools:context=".ui.climate_alerts.ClimateAlertsFragment">

        <!-- Suggestions -->
        <TextView
            android:id="@+id/text_climate_alerts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Suggestions will appear here"
            android:textSize="20sp"
            android:textAlignment="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- "Today’s Forecast" label -->
        <TextView
            android:id="@+id/forecastLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today’s Forecast:"
            android:textSize="18sp"
            android:textColor="#000"
            app:layout_constraintTop_toBottomOf="@id/text_climate_alerts"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp" />

        <!-- Location, Temperature, Icon -->
        <LinearLayout
            android:id="@+id/weatherInfo"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/forecastLabel"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/locationText"
                android:text="[Location]"
                android:textSize="18sp"
                android:textColor="#666"
                android:layout_marginEnd="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/temperatureText"
                android:text="27°C"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#1D4ED8"
                android:layout_marginEnd="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- "Climate Alerts" header -->
        <TextView
            android:id="@+id/climateAlertsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Climate Alerts"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1E3A8A"
            app:layout_constraintTop_toBottomOf="@id/weatherInfo"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="32dp" />

        <!-- Alert #1 -->
        <!-- Red Alert Box -->
        <LinearLayout
            android:id="@+id/alertBox1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#DC2626"
            android:orientation="vertical"
            android:padding="12dp"
            android:elevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/climateAlertsLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/alertTitle1"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/alertText1"
            android:textSize="14sp"
            android:textColor="#FFF9C4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Alert #2 -->
    <!-- Yellow Alert Box -->
    <LinearLayout
        android:id="@+id/alertBox2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FBBF24"
        android:orientation="vertical"
        android:padding="12dp"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/alertBox1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/alertTitle2"
            android:textSize="16sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/alertText2"
            android:textSize="14sp"
            android:textColor="#4B5563"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

        <!-- Learn More -->
        <TextView
            android:id="@+id/learnMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="→ Learn More"
            android:textSize="16sp"
            android:textColor="#000000"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/alertBox2"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

