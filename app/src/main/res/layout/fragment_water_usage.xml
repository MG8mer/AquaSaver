<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.water_usage.WaterUsageFragment"
    android:paddingStart="@dimen/activity_horizontal_margin"
    android:paddingEnd="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingBottom="@dimen/activity_vertical_margin">

    <!-- Graph Toggle -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/graph_toggle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.15"
        app:singleSelection="true">

        <Button
            android:id="@+id/day"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Day"
            android:textAllCaps="false"
            android:textSize="@dimen/body_size" />

        <Button
            android:id="@+id/week"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Week"
            android:textAllCaps="false"
            android:textSize="@dimen/body_size" />

        <Button
            android:id="@+id/month"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Month"
            android:textAllCaps="false"
            android:textSize="@dimen/body_size" />

        <Button
            android:id="@+id/year"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Year"
            android:textAllCaps="false"
            android:textSize="@dimen/body_size" />


    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/currentState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This Week"
        android:textAlignment="center"
        android:textColor="?attr/colorOnSurface"
        android:padding="0dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toTopOf="@id/water_graph"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/arrow_forward"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_margin="16dp"
        android:src="@drawable/arrow_forward"
        app:layout_constraintBottom_toTopOf="@id/water_graph"
        app:layout_constraintStart_toEndOf="@id/currentState" />

    <ImageView
        android:id="@+id/arrow_back"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_margin="16dp"
        android:src="@drawable/arrow_back"
        app:layout_constraintBottom_toTopOf="@id/water_graph"
        app:layout_constraintEnd_toStartOf="@id/currentState" />
    <!-- 16dp White Space Divider -->
    <View
        android:id="@+id/divider1"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/graph_toggle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bar Chart -->
    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/water_graph"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/divider1"
        app:layout_constraintBottom_toTopOf="@id/divider2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 16dp White Space Divider -->
    <View
        android:id="@+id/divider2"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toTopOf="@id/statistics"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Statistics -->
    <include
        android:id="@+id/statistics"
        layout="@layout/statistics"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.2" />

    <Button
        android:id="@+id/add_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
