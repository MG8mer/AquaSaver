<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.water_usage.WaterUsageFragment">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/activity_vertical_margin"
        android:layout_marginBottom="@dimen/activity_vertical_margin"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        android:layout_marginEnd="@dimen/activity_horizontal_margin"
        android:divider="@drawable/vertical_empty_divider"
        android:showDividers="middle"
        >

        <include
            android:id="@+id/graph_toggle"
            layout="@layout/graph_toggle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"

            />

        <include
            android:id="@+id/water_graph"
            layout="@layout/water_graph"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"

            />

        <include
            android:id="@+id/statistics"
            layout="@layout/statistics"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"

            />



    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>