<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ecoChallengesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F0F6FF"
    tools:context=".ui.ecochallenges.EcoChallengesFragment">

    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Eco Challenges"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1E90FF"
        android:layout_marginBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/challengesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="vertical"/>

    <Button
        android:id="@+id/buttonViewConservationTips"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Conservation Tips"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1E90FF"
        android:layout_marginBottom="8dp"
        android:background="@drawable/rounded_button"/>

    <Button
        android:id="@+id/buttonViewHome"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Back to Home"
        android:textColor="#1E90FF"
        android:backgroundTint="#E6F0FF"
        android:background="@drawable/rounded_button_outline"/>

</LinearLayout>
