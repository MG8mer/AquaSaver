<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Header with hamburger menu -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/hamburgerMenu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_menu"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/homeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Home"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginStart="-24dp" />
        </LinearLayout>

        <!-- Welcome Text -->
        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome, User"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_below="@id/headerLayout"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"/>

        <!-- Current Water Usage Title -->
        <TextView
            android:id="@+id/currentUsageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Water Usage"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_below="@id/welcomeText"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"/>

        <!-- Pie Chart -->
        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieChart"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_below="@id/currentUsageTitle"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Select Activity Title -->
        <TextView
            android:id="@+id/selectActivityTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select an activity and time"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_below="@id/pieChart"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"/>

        <!-- Icons Section -->
        <LinearLayout
            android:id="@+id/iconsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@id/selectActivityTitle"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:baselineAligned="false">

            <!-- Shower -->
            <LinearLayout
                android:id="@+id/showerButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:minHeight="80dp">

                <ImageView
                    android:id="@+id/shower_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/shower_icon"
                    android:contentDescription="Shower icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="shower"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Washer -->
            <LinearLayout
                android:id="@+id/washerButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:minHeight="80dp">

                <ImageView
                    android:id="@+id/washer_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/washer_icon"
                    android:contentDescription="Washer icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="washer"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Sprinkler -->
            <LinearLayout
                android:id="@+id/sprinklerButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:minHeight="80dp">

                <ImageView
                    android:id="@+id/sprinkler_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/sprinkler_icon"
                    android:contentDescription="Sprinkler icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="sprinkler"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Other -->
            <LinearLayout
                android:id="@+id/otherOption"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:minHeight="80dp">

                <ImageView
                    android:id="@+id/other_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/other_icon"
                    android:contentDescription="Other activities icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="other"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Timer Controls -->
        <LinearLayout
            android:id="@+id/timerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_below="@id/iconsLayout"
            android:layout_marginTop="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/decrementTimer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="−"
                android:textSize="20sp"
                android:textColor="@color/black"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_marginEnd="16dp"
                app:cornerRadius="24dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <TextView
                android:id="@+id/timerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Timer: 0 min"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:minWidth="100dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/incrementTimer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+"
                android:textSize="20sp"
                android:textColor="@color/black"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="24dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- Water Usage Preview Text -->
        <TextView
            android:id="@+id/waterUsagePreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select an activity and set a timer"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_below="@id/timerLayout"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Log Water Usage Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/logWaterUsageButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Log Water Usage"
            android:textSize="16sp"
            android:layout_below="@id/waterUsagePreview"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="20dp"
            app:cornerRadius="28dp"
            android:textAllCaps="false" />

        <!-- Undo Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/undoButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↻ Undo"
            android:textSize="14sp"
            android:layout_below="@id/logWaterUsageButton"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textAllCaps="false" />

        <!-- Conservation Tips Section -->
        <LinearLayout
            android:id="@+id/conservationSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@id/undoButton"
            android:layout_marginTop="32dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/info_ion"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/info_icon"
                android:layout_marginEnd="12dp"
                android:contentDescription="Information icon" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Wondering how to reduce your water usage? Check out our conservation tips!"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- Conservation Tips Buttons -->
        <LinearLayout
            android:id="@+id/tipsButtonsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@id/conservationSection"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/conservationTipsButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Conservation Tips"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                app:cornerRadius="24dp"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ecoChallengesButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Eco-Challenges"
                android:textSize="12sp"
                android:layout_marginStart="8dp"
                app:cornerRadius="24dp"
                android:textAllCaps="false" />
        </LinearLayout>

    </RelativeLayout>
</ScrollView>