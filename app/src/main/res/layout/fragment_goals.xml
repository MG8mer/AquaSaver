<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white"
    tools:context=".ui.goals.GoalsFragment">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Title -->
        <TextView
            android:id="@+id/titleGoals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Goals"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="16dp" />

        <!-- Goal Type and Amount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/goalTypeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Type: Daily"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/goalAmountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Goal Amount: 100 L"
                android:textSize="16sp"
                android:gravity="end" />
        </LinearLayout>

        <!-- Progress Bar -->
        <LinearLayout
            android:id="@+id/progressBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginVertical="8dp">

            <!-- Example segment colors -->
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="16dp" android:background="@color/progress_blue"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="16dp" android:background="@color/progress_blue"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="16dp" android:background="@color/progress_blue"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="16dp" android:background="@color/progress_blue"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="16dp" android:background="@color/progress_yellow"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="16dp" android:background="@color/progress_yellow"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="16dp" android:background="@color/progress_yellow"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="16dp" android:background="@color/progress_orange"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="16dp" android:background="@color/progress_red"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="16dp" android:background="@color/progress_red"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="16dp" android:background="@color/progress_red"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="16dp" android:background="@color/progress_red"/>
        </LinearLayout>

        <!-- Streak & Challenges -->
        <TextView
            android:id="@+id/streakText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Streak: 3 days 🔥"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/challengesCompletedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Challenges Completed: 2"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"/>

        <!-- Divider -->
        <View
            android:layout_marginVertical="12dp"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#888888"/>

        <!-- Eco Challenges Header -->
        <TextView
            android:text="Eco-Challenges"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Challenge List -->
        <LinearLayout
            android:id="@+id/challengeListLayout"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="20dp" />


        <!-- Record Button -->
        <Button
            android:id="@+id/recordChallengeButton"
            android:text="Record Challenge Progress"
            android:layout_marginTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"/>

        <!-- Challenge Indicator (carousel dots) -->
        <LinearLayout
            android:id="@+id/challengeIndicatorLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">
            <!-- Dynamically add page indicators here -->
        </LinearLayout>

    </LinearLayout>
</ScrollView>
