<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white"
    tools:context=".ui.goals.GoalsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="32dp">

        <!-- Title -->
        <TextView
            android:id="@+id/titleGoals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Goals"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingBottom="24dp" />

        <!-- Goal Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/goalTypeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Type: Daily"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/goalAmountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Goal: 100 L"
                android:textSize="16sp"
                android:gravity="end" />
        </LinearLayout>

        <!-- Progress Bar -->
        <LinearLayout
            android:id="@+id/progressBarContainer"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:background="#EEE"
            android:padding="2dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginTop="8dp">

            <!-- Progress Segments -->
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@color/progress_blue"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@color/progress_blue"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@color/progress_blue"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@color/progress_blue"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@color/progress_yellow"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@color/progress_yellow"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@color/progress_yellow"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@color/progress_orange"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@color/progress_red"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@color/progress_red"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@color/progress_red"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@color/progress_red"/>
        </LinearLayout>

        <!-- Streak -->
        <TextView
            android:id="@+id/streakText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Streak: 3 days 🔥"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <!-- Challenges Completed -->
        <TextView
            android:id="@+id/challengesCompletedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Challenges Completed: 2"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#CCCCCC" />

        <!-- Eco Challenges Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eco-Challenge"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/challengeContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/challengeTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:paddingBottom="8dp"
                android:text="Challenge Title" />

            <TextView
                android:id="@+id/challengeDescriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#444444"
                android:paddingBottom="16dp"
                android:text="Challenge description goes here" />

            <Button
                android:id="@+id/completeChallengeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complete Challenge" />

            <TextView
                android:id="@+id/noChallengesMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎉 No challenges available! You've completed them all."
                android:textSize="18sp"
                android:textColor="#4CAF50"
                android:gravity="center"
                android:visibility="gone"
                android:paddingTop="20dp" />

        </LinearLayout>

        <!-- Challenge Page Indicator -->
        <LinearLayout
            android:id="@+id/challengeIndicatorLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
